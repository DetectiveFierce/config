#!/usr/bin/python3
"""Stable local entry point used by DMS and systemd."""
import os
import sys

# bin/ is deployed as a symlink, so resolve back to the repository.
_repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_repo, "storage-advisor"))
from storage_advisor.cli import main

raise SystemExit(main())
