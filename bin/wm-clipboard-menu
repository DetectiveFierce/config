#!/usr/bin/env bash
set -euo pipefail

# Clipboard history picker, shared by Hyprland and niri: DankMaterialShell's
# clipboard modal. The cliphist-* user services keep recording history.
if ! command -v dms >/dev/null 2>&1; then
  notify-send "Clipboard unavailable" "DankMaterialShell (dms) is not installed." >/dev/null 2>&1 || true
  exit 1
fi

exec dms ipc call clipboard toggle
