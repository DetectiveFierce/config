#!/usr/bin/env bash
set -euo pipefail

PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$@"
  fi
}

picker="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles-deps/hyprpicker-styled/bin/hyprpicker-styled"

for dep in wl-copy; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    notify "Color picker failed" "Missing dependency: $dep"
    exit 1
  fi
done

if [[ ! -x "$picker" ]]; then
  notify "Color picker failed" "Run ~/config/dotfiles bootstrap to build the styled picker"
  exit 1
fi

color="$("$picker" --autocopy --format=hex --no-fancy --scale=10 --radius=70 || true)"
if [[ -z "${color:-}" ]]; then
  exit 0
fi

hex="${color:0:7}"
printf '%s' "$hex" | wl-copy
notify -a "Color Picker" -u low -t 1000 -e "Color copied: $hex"
