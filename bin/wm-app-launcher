#!/usr/bin/env bash
set -euo pipefail

# Graphical sessions can miss /usr/sbin, where some packaged binaries live.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

vicinae_cmd="$(command -v vicinae || command -v vicinae-bin || true)"

if [[ -z "$vicinae_cmd" ]]; then
  notify-send "Application launcher unavailable" "Install vicinae." >/dev/null 2>&1 || true
  exit 1
fi

# Toggle the running server; start it with the launcher open if it isn't up yet.
"$vicinae_cmd" toggle >/dev/null 2>&1 || exec "$vicinae_cmd" server --open
