// Desktop monitor topology. Positions use logical pixels after scaling.
output "HDMI-A-2" {
    mode "1920x1080"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080"
    scale 1
    transform "normal"
    position x=1920 y=0
}

output "DP-1" {
    mode "2560x1600@60"
    scale 2
    transform "normal"
    position x=1120 y=1080
}
