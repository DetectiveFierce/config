// Tracked niri configuration. DMS-owned fragments are repository-backed, so
// changes made in the DMS GUI are visible to Git and remain portable.

include "core/input.kdl"
include "dms/cursor.kdl"
include "outputs/laptop.kdl"
include "outputs/desktop.kdl"
include "dms/outputs.kdl"
include "core/workspaces.kdl"
include "core/layout.kdl"
include "core/appearance.kdl"
include "dms/layout.kdl"
include "dms/colors.kdl"
include "core/session.kdl"
include "rules/applications.kdl"
include "dms/windowrules.kdl"
include "dms/wpblur.kdl"
include "dms/alttab.kdl"
include "binds/window-management.kdl"
include "binds/applications.kdl"
include "binds/system.kdl"
include "dms/binds.kdl"

// Local, ignored selector for machines/{desktop,laptop}.kdl.
include optional=true "machine.kdl"
