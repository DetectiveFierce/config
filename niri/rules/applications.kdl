window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Leave enough columns for the two-column startup fetch at Ghostty's 16 pt font.
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    default-column-width { proportion 0.8; }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Fill the usable workspace while retaining the standard gaps and rounded corners.
window-rule {
    match app-id=r#"^zen$"#
    open-maximized true
    // Zen restores an OS-maximized state; keep it in Niri's rounded mode.
    open-maximized-to-edges false
}

window-rule {
    match app-id=r#"^float-term$"#
    open-floating true
    default-column-width { proportion 0.8; }
}

window-rule {
    match title="^Sticky Note$"
    open-floating true
    default-column-width { proportion 0.45; }
}

window-rule {
    match app-id=r#"^(Codex|Chatgpt|ChatGPT|chatgpt|com\.anthropic\.Claude)$"#
    open-maximized true
    open-maximized-to-edges false
}

window-rule {
    match app-id=r#"^md\.obsidian\.Obsidian$"#
    open-maximized true
    open-maximized-to-edges false
}

// pi-gui identifies itself as "pi" on Wayland. Keep the standard gaps and
// geometry corner radius while occupying the full usable output.
window-rule {
    match app-id=r#"^pi$"#
    open-maximized true
    open-maximized-to-edges false
}
