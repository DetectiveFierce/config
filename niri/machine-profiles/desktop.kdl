// Desktop hardware/function keys.
binds {
    XF86MonBrightnessUp allow-when-locked=true { spawn "wm-brightness-external" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "wm-brightness-external" "down"; }
    F3 allow-when-locked=true { spawn "wm-brightness-external" "up"; }
    F2 allow-when-locked=true { spawn "wm-brightness-external" "down"; }
}
