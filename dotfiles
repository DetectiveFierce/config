#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OH_MY_ZSH_COMMIT="c5ba74cf02cce4c342153f79089100194f30940f"
SPACESHIP_COMMIT="fd0d6653a134fe28f498eae1784fbb46d27f20f3"
ZSH_AUTOSUGGESTIONS_COMMIT="e52ee8ca55bcc56a17c828767a3f98f22a68d4eb"
ZSH_SYNTAX_HIGHLIGHTING_COMMIT="db085e4661f6aafd24e5acb5b2e17e4dd5dddf3e"

usage() {
  cat <<'EOF'
Usage:
  dotfiles apply [DOTTER OPTIONS]
  dotfiles remove [DOTTER OPTIONS]
  dotfiles status
  dotfiles doctor
  dotfiles bootstrap

Commands:
  apply      Deploy the selected Dotter packages.
  remove     Undeploy files recorded in Dotter's cache.
  status     Preview changes Dotter would make.
  doctor     Validate Dotter configuration and pinned dependencies.
  bootstrap  Install pinned shell dependencies and enable user services.

Run `dotter --help` for deployment options. In particular, use `-d` for a
dry run and `-f` only when you intend to replace conflicting targets.
EOF
}

require_dotter() {
  if ! command -v dotter >/dev/null 2>&1; then
    echo "error: Dotter is required but not installed (package: dotter-rs)." >&2
    return 1
  fi
  if [[ ! -f "$DOTFILES_DIR/.dotter/local.toml" ]]; then
    echo "error: .dotter/local.toml is missing." >&2
    echo "       Copy .dotter/local.toml.example and select this machine's profiles." >&2
    return 1
  fi
}

run_dotter() {
  require_dotter
  (cd "$DOTFILES_DIR" && dotter "$@")
}

checkout_pinned_dependency() {
  local name="$1"
  local url="$2"
  local destination="$3"
  local commit="$4"

  if [[ ! -d "$destination/.git" ]]; then
    if [[ -e "$destination" ]]; then
      echo "error: $destination exists but is not a Git checkout." >&2
      return 1
    fi
    mkdir -p "$(dirname "$destination")"
    git clone "$url" "$destination"
  fi

  if [[ -n "$(git -C "$destination" status --porcelain)" ]]; then
    echo "error: refusing to change dirty $name checkout: $destination" >&2
    return 1
  fi

  if ! git -C "$destination" cat-file -e "$commit^{commit}" 2>/dev/null; then
    git -C "$destination" fetch origin "$commit"
  fi
  git -C "$destination" checkout --detach "$commit"
}

bootstrap() {
  local data_home omz_dir custom_dir spaceship_dir spaceship_link
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  omz_dir="$data_home/oh-my-zsh"
  custom_dir="$omz_dir/custom"
  spaceship_dir="$custom_dir/themes/spaceship-prompt"
  spaceship_link="$custom_dir/themes/spaceship.zsh-theme"

  if ! command -v git >/dev/null 2>&1; then
    echo "error: git is required for bootstrap." >&2
    return 1
  fi

  checkout_pinned_dependency \
    "Oh My Zsh" \
    "https://github.com/ohmyzsh/ohmyzsh.git" \
    "$omz_dir" \
    "$OH_MY_ZSH_COMMIT"
  checkout_pinned_dependency \
    "Spaceship" \
    "https://github.com/spaceship-prompt/spaceship-prompt.git" \
    "$spaceship_dir" \
    "$SPACESHIP_COMMIT"
  checkout_pinned_dependency \
    "zsh-autosuggestions" \
    "https://github.com/zsh-users/zsh-autosuggestions.git" \
    "$custom_dir/plugins/zsh-autosuggestions" \
    "$ZSH_AUTOSUGGESTIONS_COMMIT"
  checkout_pinned_dependency \
    "zsh-syntax-highlighting" \
    "https://github.com/zsh-users/zsh-syntax-highlighting.git" \
    "$custom_dir/plugins/zsh-syntax-highlighting" \
    "$ZSH_SYNTAX_HIGHLIGHTING_COMMIT"

  if [[ -e "$spaceship_link" || -L "$spaceship_link" ]]; then
    if [[ ! -L "$spaceship_link" ]] || \
      [[ "$(readlink "$spaceship_link")" != "spaceship-prompt/spaceship.zsh-theme" ]]; then
      echo "error: refusing to replace unexpected Spaceship theme path: $spaceship_link" >&2
      return 1
    fi
  else
    ln -s "spaceship-prompt/spaceship.zsh-theme" "$spaceship_link"
  fi

  "$DOTFILES_DIR/scripts/build-hyprpicker-styled.sh"

  systemctl --user daemon-reload
  systemctl --user enable cliphist-text.service cliphist-image.service wallpaper-daemon.service wallpaper-switch.timer
  systemctl --user add-wants niri.service dms.service

  echo "Bootstrap complete. Oh My Zsh and Zsh prompt dependencies are pinned."
}

doctor() {
  require_dotter
  echo "dotter: $(command -v dotter) ($(dotter --version))"
  echo "dotfiles dir: $DOTFILES_DIR"

  local omz_dir custom_dir
  omz_dir="${XDG_DATA_HOME:-$HOME/.local/share}/oh-my-zsh"
  custom_dir="$omz_dir/custom"
  if [[ ! -d "$omz_dir/.git" ]]; then
    echo "warning: Oh My Zsh is not bootstrapped; run ./dotfiles bootstrap." >&2
  elif [[ "$(git -C "$omz_dir" rev-parse HEAD 2>/dev/null || true)" != "$OH_MY_ZSH_COMMIT" ]]; then
    echo "warning: Oh My Zsh is not at the pinned revision; run ./dotfiles bootstrap." >&2
  fi
  if [[ "$(git -C "$custom_dir/themes/spaceship-prompt" rev-parse HEAD 2>/dev/null || true)" != "$SPACESHIP_COMMIT" ]] ||
    [[ "$(git -C "$custom_dir/plugins/zsh-autosuggestions" rev-parse HEAD 2>/dev/null || true)" != "$ZSH_AUTOSUGGESTIONS_COMMIT" ]] ||
    [[ "$(git -C "$custom_dir/plugins/zsh-syntax-highlighting" rev-parse HEAD 2>/dev/null || true)" != "$ZSH_SYNTAX_HIGHLIGHTING_COMMIT" ]]; then
    echo "warning: Zsh prompt dependencies are not bootstrapped; run ./dotfiles bootstrap." >&2
  fi

  echo
  echo "Running Dotter dry-run validation..."
  run_dotter deploy --dry-run
}

main() {
  if [[ "$#" -lt 1 ]]; then
    usage
    exit 1
  fi

  local command="$1"
  shift
  case "$command" in
    apply) run_dotter deploy "$@" ;;
    remove) run_dotter undeploy "$@" ;;
    status) run_dotter deploy --dry-run "$@" ;;
    doctor) doctor "$@" ;;
    bootstrap) bootstrap "$@" ;;
    -h|--help|help) usage ;;
    *)
      echo "error: unknown command: $command" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
