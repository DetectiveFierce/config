+static void roundedRectangle(cairo_t* cairo, double x, double y, double width, double height, double radius) {
+    cairo_new_sub_path(cairo);
+    cairo_arc(cairo, x + width - radius, y + radius, radius, -M_PI_2, 0);
+    cairo_arc(cairo, x + width - radius, y + height - radius, radius, 0, M_PI_2);
+    cairo_arc(cairo, x + radius, y + height - radius, radius, M_PI_2, M_PI);
+    cairo_arc(cairo, x + radius, y + radius, radius, M_PI, 3 * M_PI_2);
+    cairo_close_path(cairo);
+}
